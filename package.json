    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tailwindcss/vite": "^4.1.13",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox__polyline": "^1.0.5",
