# Strava API application (https://www.strava.com/settings/api)
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/callback

# Optional: Carto basemap API key for higher-reliability tile serving.
# Leave blank to use Carto's free, no-key basemaps.cartocdn.com tiles instead.
VITE_CARTO_API_KEY=

# Used by netlify/functions to exchange/refresh the OAuth code (never exposed to the browser).
# The client ID isn't secret, so the functions reuse VITE_STRAVA_CLIENT_ID above.
CLIENT_SECRET=
